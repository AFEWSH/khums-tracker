{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "khums-finance/khums-finance",
    "type": "project",
    "description": "Private, offline-first Persian personal finance application.",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:environment": "@php scripts/check-environment.php",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/pest",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "dev": "@php artisan serve --host=127.0.0.1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
